# ---- Corridor: data & secrets (NEVER commit) ----
# The SQLite DB and Parquet snapshots are local point-in-time state.
# They are rebuilt/accumulated by the daily refresh job, not version-controlled.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/snapshots/
*.parquet

# Secrets
.env
.env.local

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
