# Corridor — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored and holds secrets/paths only.
# Methodology parameters (watchlist, percentile bands, PEG growth basis, etc.)
# live in config.yaml, NOT here.

# --- SEC EDGAR ---
# EDGAR's fair-access policy REQUIRES a descriptive User-Agent that includes a
# contact email. Requests without it get rate-limited/blocked. Use your real email.
SEC_EDGAR_USER_AGENT="Corridor Research personal-use (your-email@example.com)"

# --- Storage ---
# SQLite database location (point-in-time queryable state).
CORRIDOR_DATABASE_URL="sqlite:///data/corridor.db"
# Directory for immutable Parquet snapshots (raw point-in-time pulls).
CORRIDOR_SNAPSHOT_DIR="data/snapshots"

# --- Optional: paid historical-estimates provider (NOT used in v1) ---
# Leave blank until you decide to load a purchased forward-estimate history.
# The data-source interface lets you swap this in WITHOUT changing the engine.
# HISTORICAL_ESTIMATES_PROVIDER=""
# HISTORICAL_ESTIMATES_API_KEY=""
